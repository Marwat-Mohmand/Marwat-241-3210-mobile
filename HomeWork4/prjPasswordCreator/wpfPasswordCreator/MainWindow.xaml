<Window x:Class="PasswordCreator.Wpf.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{Binding Title}" Width="920" Height="790"
        MinWidth="650" MinHeight="500" Background="#F2F5FB" FontFamily="Segoe UI" FontSize="14">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28">
      <TextBlock Text="{Binding Title}" FontSize="27" FontWeight="Bold" Foreground="#192C55"/>
      <TextBlock Text="{Binding Subtitle}" Margin="0,6,0,20" Foreground="#53627B"/>
      <Border Background="White" Padding="22" CornerRadius="12">
        <StackPanel>
          <TextBlock Text="Готовые профили" FontWeight="SemiBold"/>
          <ComboBox x:Name="PresetPicker" ItemsSource="{Binding Presets}" SelectionChanged="PresetChanged"/>
          <TextBlock Text="Режим"/><ComboBox ItemsSource="{Binding Modes}" SelectedIndex="{Binding ModeIndex}"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel IsEnabled="{Binding IsCharacterMode}"><TextBlock Text="Длина (1–256)"/><TextBox Text="{Binding Length, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="Количество (1–100)"/><TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"/></StackPanel>
          </Grid>
          <WrapPanel IsEnabled="{Binding IsRandomMode}">
            <CheckBox Content="abc" IsChecked="{Binding Lowercase}"/><CheckBox Content="ABC" IsChecked="{Binding Uppercase}"/>
            <CheckBox Content="123" IsChecked="{Binding Digits}"/><CheckBox Content="!@#" IsChecked="{Binding Symbols}"/>
          </WrapPanel>
          <WrapPanel IsEnabled="{Binding IsCharacterMode}"><CheckBox Content="Без похожих O0oIl1|" IsChecked="{Binding ExcludeAmbiguous}"/>
    <CheckBox Content="Без повторов" IsChecked="{Binding NoRepeatedCharacters}"/></WrapPanel>
  <TextBlock Text="Исключить символы (пароль / PIN / свой алфавит)"/><TextBox Text="{Binding ExcludedCharacters, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCharacterMode}"/>
  <TextBlock Text="Свой алфавит"/><TextBox Text="{Binding CustomAlphabet, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsCustomMode}"/>
  <Grid IsEnabled="{Binding IsPhraseMode}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Слов во фразе (4–12)"/><TextBox Text="{Binding WordCount, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
    <StackPanel Grid.Column="2"><TextBlock Text="Разделитель (0–3 символа)"/><TextBox Text="{Binding Separator, UpdateSourceTrigger=PropertyChanged}"/></StackPanel>
  </Grid>
          <WrapPanel Margin="0,16,0,4">
            <Button Content="Сгенерировать" Click="GenerateClick" Background="#2457D6" Foreground="White" IsDefault="True"/>
            <Button Content="Копировать" Click="CopyClick"/><Button Content="Сохранить TXT" Click="SaveClick"/>
            <Button Content="Очистить" Command="{Binding ClearCommand}"/><Button Content="Запомнить настройки" Click="SettingsClick"/>
          </WrapPanel>
          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="#2457A6" Margin="0,4,0,10"/>
          <TextBlock Text="Результаты" FontWeight="SemiBold"/>
          <TextBox Text="{Binding Output, Mode=OneWay}" IsReadOnly="True" MinHeight="140" MaxHeight="280" FontFamily="Consolas"
                   TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
          <TextBlock Text="{Binding Estimate}" TextWrapping="Wrap" FontSize="12" Foreground="#53627B"/>
          <TextBlock Text="История сеанса · до 50 паролей · очищается кнопкой «Очистить»" Margin="0,18,0,0" TextWrapping="Wrap"/>
  <TextBox Text="{Binding HistoryText, Mode=OneWay}" IsReadOnly="True" Height="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas"/>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Window>
