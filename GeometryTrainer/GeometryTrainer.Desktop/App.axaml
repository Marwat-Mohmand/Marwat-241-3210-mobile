<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GeometryTrainer.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#3478F6" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://GeometryTrainer.Desktop/Styles/Theme.axaml" />
    </Application.Styles>
</Application>
